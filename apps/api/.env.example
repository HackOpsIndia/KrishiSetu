# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/krishisetu?schema=public"

# Security & Session
JWT_SECRET="krishisetu-demo-secret-change-in-production"
DEMO_MODE=false

# Initial Platform Administrators (comma-separated, normalized on startup)
ADMIN_EMAILS="admin@demo.in,admin@krishisetu.in"

# Production SMTP Email Transport
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KrishiSetu <no-reply@krishisetu.gov.in>"

# Email OTP Authentication Parameters
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Google OAuth Credentials (optional in demo mode, required for live Google OAuth in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# Service Ports & Networking
PORT=4000
CORS_ORIGIN="http://localhost:3000"
